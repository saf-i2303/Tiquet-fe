# Origin backend Golang/Fiber untuk fetch server-side (server-only).
# Dipakai juga oleh rewrite Next.js bila NEXT_PUBLIC_API_URL masih relatif.
API_UPSTREAM_URL=http://localhost:8080

# Base URL API yang dipakai browser. URL absolut = direct call via CORS.
# Boleh origin saja atau sudah termasuk /api/v1.
# Gunakan "/api/v1" hanya sebagai fallback proxy Next.js.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Set "false" untuk memakai backend asli. Default: mock data lokal.
NEXT_PUBLIC_USE_MOCK=false

# Preview tampilan: "true" mematikan proxy/middleware + guard login
# sehingga semua halaman (customer, organizer, admin) bisa dibuka tanpa auth.
# Set "false" untuk mengaktifkan kembali login & proteksi route.
# Catatan: NEXT_PUBLIC_* dibaca saat build, jadi restart dev server / rebuild setelah mengubah.
NEXT_PUBLIC_PREVIEW_MODE=false

# Rahasia untuk menandatangani cookie sesi yang dibaca server guard.
# WAJIB diisi di production dengan nilai acak yang sama untuk semua instance.
AUTH_SECRET=replace-with-a-long-random-secret
