# Base URL backend Golang/Fiber, contoh: http://localhost:8080/api
NEXT_PUBLIC_API_URL=

# Set "false" untuk memakai backend asli. Default: mock data lokal.
NEXT_PUBLIC_USE_MOCK=true

# Preview tampilan: "true" mematikan proxy/middleware + guard login
# sehingga semua halaman (customer, organizer, admin) bisa dibuka tanpa auth.
# Set "false" untuk mengaktifkan kembali login & proteksi route.
# Catatan: NEXT_PUBLIC_* dibaca saat build, jadi restart dev server / rebuild setelah mengubah.
NEXT_PUBLIC_PREVIEW_MODE=true
